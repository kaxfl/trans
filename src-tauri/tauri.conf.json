{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "划词翻译",
  "mainBinaryName": "划词翻译",
  "version": "1.6.1",
  "identifier": "com.amsit.jishifanyi",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "划词翻译",
        "width": 460,
        "height": 420,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../data/dict.bin": "dict.bin"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer.nsh",
        "startMenuFolder": "划词翻译"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
